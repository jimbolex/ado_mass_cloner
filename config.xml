<?xml version="1.0" encoding="utf-8"?>

<Configuration>

    <AzureDevOps>

        <OrganizationUrl>https://upsdiv.visualstudio.com</OrganizationUrl>
        <Project>Core</Project>

    </AzureDevOps>

    <Destination>

        <AreaPath>Core</AreaPath>
        <IterationPath>Core</IterationPath>

    </Destination>

    <CloneOptions>

        <CopyAttachments>true</CopyAttachments>
        <ReplaceQAWithUAT>true</ReplaceQAWithUAT>
        <DelayBetweenStoriesSeconds>2</DelayBetweenStoriesSeconds>
        
    </CloneOptions>

    <UserStoriesSource>

        <UseLocalFolder>true</UseLocalFolder>
        <UseTemplate>true</UseTemplate>

        <Template>
            <Folder>Template</Folder>
            <FileName>US To Clone Template.txt</FileName>
        </Template>

        <LocalFolder>
            <InputFolder>Input</InputFolder>
            <DoneFolder>Input/Done</DoneFolder>
            <RetryFolder>Input/Retry</RetryFolder>      
        </LocalFolder>

        <OneDrive>
            <InputFolder>UPS NON-CIM - US to Clone</InputFolder>
            <DoneFolder>UPS NON-CIM - US to Clone/Done</DoneFolder>
            <RetryFolder>UPS NON-CIM - US to Clone/Retry</RetryFolder>  
        </OneDrive>       

    </UserStoriesSource>

    <Retry>
        <RetryAttempts>3</RetryAttempts>
        <RetryDelaySeconds>2</RetryDelaySeconds>
    </Retry>

</Configuration>